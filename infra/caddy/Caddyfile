# Caddyfile — production reverse proxy with automatic HTTPS.
# Replace `gestionpatrimonial.example` with your real domain before deploying.

{
  email admin@gestionpatrimonial.example
}

gestionpatrimonial.example {
  # Static frontend (Next.js)
  reverse_proxy /api/* api:8000
  reverse_proxy /* web:3000

  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
}
